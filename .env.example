# Copy this file to .env and fill in your key (free at console.groq.com/keys).
GROQ_API_KEY=gsk-your-key-here
# Optional: chat model (openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-20b
# Optional: voice (troy, austin, daniel, hannah, diana, autumn)
GROQ_VOICE=troy

# Only needed for the OpenAI services in voicepipe/services/openai_service.py
# OPENAI_API_KEY=sk-your-key-here
